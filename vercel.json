{
  "version": 2,
  "installCommand": "npm install",
  "builds": [
    {
      "src": "backend/api/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/api/index.js"
    },
    {
      "src": "/$",
      "dest": "/frontend/pages/index.html"
    },
    {
      "src": "/(login|register|dashboard|upload|forget-password|reset-password)",
      "dest": "/frontend/$1.html"
    },
    {
      "src": "/(login|register|dashboard|upload|forget-password|reset-password)\\.html",
      "dest": "/frontend/pa$1.html"
    },
    {
      "src": "/css/(.*)",
      "dest": "/frontend/css/$1"
    },
    {
      "src": "/js/(.*)",
      "dest": "/frontend/js/$1"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/frontend/assets/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/$1"
    }
  ]
}